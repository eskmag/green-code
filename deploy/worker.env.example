# Kopier til /etc/greencode/worker.env og fyll inn. Filen skal bare kunne leses av root og greencode.
GREENCODE_API_URL=https://green-code.vercel.app
GREENCODE_WORKER_TOKEN=lim-inn-WORKER_TOKEN-fra-vercel
GREENCODE_WORKER_ID=laptop-x86
GREENCODE_POLL_SECONDS=15
GREENCODE_IDLE_SECONDS=10
GREENCODE_WARMUP=2
